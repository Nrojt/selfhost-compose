{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pinDigests": true,
  "docker-compose": {
    "fileMatch": [
      "^[^/]+\\.ya?ml$"
    ]
  },
  "dockerfile": {
    "fileMatch": [
      "(^|/)Dockerfile$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^opencode/Dockerfile$"
      ],
      "matchStrings": [
        "ARG GODOT_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "godotengine/godot",
      "versioningTemplate": "semver"
    }
  ]
}
