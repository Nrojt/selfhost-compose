{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pinDigests": true,
  "docker-compose": {
    "managerFilePatterns": [
      "/^[^/]+\\.ya?ml$/"
    ]
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Dockerfile$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^opencode/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG GODOT_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "godotengine/godot",
      "versioningTemplate": "semver"
    }
  ]
}
