#!/usr/bin/env python3
"""Fill the marked (white) region of an image.

Local OpenCV fill by default (small defects: text, watermarks, scratches).
--ai PROMPT sends the marked image to OpenRouter for a semantic fill, which
re-generates the whole frame and needs OPENROUTER_API_KEY.
"""
import argparse
import base64
import io
import json
import os
import sys
import urllib.request

import cv2
import numpy as np
from PIL import Image

AI_URL = "https://openrouter.ai/api/v1/images"
AI_MODEL = "google/gemini-3.1-flash-image"


def load_mask(path, size):
    m = Image.open(path)
    if m.mode in ("RGBA", "LA"):
        m = m.getchannel("A")
    a = np.array(m.convert("L").resize(size, Image.NEAREST))
    mask = (a > 127).astype(np.uint8) * 255
    if not mask.any():
        sys.exit("inpaint: mask is empty, nothing marked")
    return mask


def fill_local(img, mask, radius):
    bgr = cv2.cvtColor(np.array(img.convert("RGB")), cv2.COLOR_RGB2BGR)
    filled = cv2.inpaint(bgr, mask, radius, cv2.INPAINT_TELEA)
    return Image.fromarray(cv2.cvtColor(filled, cv2.COLOR_BGR2RGB))


def fill_ai(img, mask, prompt, opacity):
    key = os.environ.get("OPENROUTER_API_KEY")
    if not key:
        sys.exit("inpaint: --ai needs OPENROUTER_API_KEY in the container environment")
    base = np.array(img.convert("RGB"))
    marked = base.copy()
    marked[mask > 0] = (255, 0, 255)
    buf = io.BytesIO()
    Image.fromarray(cv2.addWeighted(base, 1 - opacity, marked, opacity, 0)).save(buf, "PNG")
    body = {
        "model": os.environ.get("INPAINT_MODEL", AI_MODEL),
        "prompt": prompt.strip() + " Keep everything outside the magenta area unchanged and blend the repair edge in.",
        "input_references": [{"type": "image_url", "image_url": {
            "url": "data:image/png;base64," + base64.b64encode(buf.getvalue()).decode()}}],
    }
    req = urllib.request.Request(AI_URL, json.dumps(body).encode(), {
        "Authorization": "Bearer " + key, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=180) as resp:
        res = json.load(resp)
    if res.get("error"):
        sys.exit(f"inpaint: OpenRouter error: {res['error']}")
    data = res["data"][0]
    raw = (base64.b64decode(data["b64_json"]) if data.get("b64_json")
           else urllib.request.urlopen(data["url"], timeout=120).read())
    print(f"inpaint: {res.get('model', body['model'])}, cost ${res.get('usage', {}).get('cost')}", file=sys.stderr)
    return Image.open(io.BytesIO(raw))


def main():
    p = argparse.ArgumentParser(description="Fill the white area of MASK in IMAGE.")
    p.add_argument("image")
    p.add_argument("mask")
    p.add_argument("out")
    p.add_argument("--radius", type=int, default=5, help="local fill radius in pixels (default 5)")
    p.add_argument("--ai", metavar="PROMPT", help="semantic fill via OpenRouter instead of OpenCV")
    p.add_argument("--opacity", type=float, default=0.6, help="marking strength for --ai (default 0.6)")
    a = p.parse_args()

    img = Image.open(a.image)
    mask = load_mask(a.mask, img.size)
    if a.ai:
        out = fill_ai(img, mask, a.ai, a.opacity)
    else:
        out = fill_local(img, mask, a.radius)
    out.convert("RGB").save(a.out)
    print(f"{a.out} ({out.size[0]}x{out.size[1]}, {'ai' if a.ai else 'local'})")


if __name__ == "__main__":
    main()
